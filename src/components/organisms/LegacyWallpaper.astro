---
import { url } from "@utils/url-utils";

const desktop = Array.from({ length: 8 }, (_, i) =>
	url("/assets/desktop-banner/d" + (i + 1) + ".webp"),
);
const mobile = Array.from({ length: 8 }, (_, i) =>
	url("/assets/mobile-banner/m" + (i + 1) + ".webp"),
);
---

<div
	id="legacy-wallpaper"
	aria-hidden="true"
	data-desktop={JSON.stringify(desktop)}
	data-mobile={JSON.stringify(mobile)}
>
	<picture>
		<source media="(max-width: 1023px)" srcset={mobile[0]} />
		<img src={desktop[0]} alt="" decoding="async" />
	</picture>
</div>

<script>
	const wallpaper = document.querySelector<HTMLElement>("#legacy-wallpaper");
	const photo = wallpaper?.querySelector("img");
	const source = wallpaper?.querySelector("source");
	if (wallpaper && photo && source) {
		const desktop: string[] = JSON.parse(wallpaper.dataset.desktop ?? "[]");
		const mobile: string[] = JSON.parse(wallpaper.dataset.mobile ?? "[]");
		const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
		let index = 0;
		setInterval(() => {
			if (document.hidden || reduced.matches || document.documentElement.dataset.wallpaperMode === "none") return;
			index = (index + 1) % desktop.length;
			source.srcset = mobile[index];
			photo.src = desktop[index];
		}, 8000);
	}
</script>

<style>
	#legacy-wallpaper {
		position: fixed;
		z-index: -1;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}

	img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.45;
		filter: blur(2.5px);
	}

	:global(html[data-wallpaper-mode="none"]) #legacy-wallpaper {
		display: none;
	}

	:global(html[data-wallpaper-mode="banner"] body) {
		--card-bg: color-mix(in srgb, var(--surface-container-lowest) 92%, transparent);
	}

	:global(html.dark[data-wallpaper-mode="banner"] body) {
		--card-bg: color-mix(in srgb, var(--surface-container-high) 92%, transparent);
	}
</style>
